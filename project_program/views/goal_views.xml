<odoo>
    <record id="view_goal_list" model="ir.ui.view"><field name="name">project.program.goal.list</field><field name="model">project.milestone</field><field name="arch" type="xml"><list><field name="name"/><field name="project_id"/><field name="goal_unit"/><field name="goal_baseline"/><field name="goal_target"/><field name="goal_direction"/><field name="has_measurement"/><field name="current_value"/><field name="progress_percent"/><field name="superseded"/></list></field></record>
    <record id="view_goal_form" model="ir.ui.view"><field name="name">project.program.goal.form</field><field name="model">project.milestone</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="project_id"/><field name="is_program_goal" invisible="1"/><field name="goal_revision_of_id" readonly="1"/><field name="superseded" readonly="1"/></group><group><field name="goal_description"/><field name="goal_unit"/><field name="goal_baseline"/><field name="goal_target"/><field name="goal_direction"/></group><group><field name="has_measurement"/><field name="current_value" invisible="not has_measurement"/><field name="progress_percent" invisible="not has_measurement"/></group><notebook><page string="Measurements"><field name="measurement_ids"><list><field name="measured_at"/><field name="value"/><field name="state"/><field name="review_id"/></list></field></page></notebook></sheet></form></field></record>
    <record id="view_goal_search" model="ir.ui.view"><field name="name">project.program.goal.search</field><field name="model">project.milestone</field><field name="arch" type="xml"><search><field name="name"/><field name="project_id"/><filter name="without_measurement" string="Without Measurement" domain="[('measurement_ids','not any',[('state','=','validated'),('replaced_by_id','=',False)])]"/><filter name="current" string="Current" domain="[('superseded','=',False)]"/><group><filter name="project" string="Project" context="{'group_by':'project_id'}"/><filter name="unit" string="Unit" context="{'group_by':'goal_unit'}"/></group></search></field></record>
    <record id="action_goals" model="ir.actions.act_window"><field name="name">Goals</field><field name="res_model">project.milestone</field><field name="view_mode">list,form</field><field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('view_goal_list')}),(0,0,{'view_mode':'form','view_id':ref('view_goal_form')})]"/><field name="domain">[('is_program_goal','=',True)]</field><field name="context">{'default_is_program_goal': True}</field></record>
    <menuitem id="menu_goals" name="Goals" parent="menu_program_root" action="action_goals" sequence="20"/>
    <record id="view_measurement_form" model="ir.ui.view"><field name="name">project.program.measurement.form</field><field name="model">project.program.measurement</field><field name="arch" type="xml"><form><header><button name="action_validate" type="object" string="Validate" invisible="state != 'draft'" class="oe_highlight"/><field name="state" widget="statusbar"/></header><sheet><group><field name="goal_id"/><field name="measured_at"/><field name="value"/><field name="review_id"/><field name="replaces_id"/><field name="correction_reason"/></group><group><field name="evidence_note"/><field name="evidence_attachment_ids" widget="many2many_binary"/><field name="validated_by"/><field name="validated_at"/></group></sheet></form></field></record>
    <record id="action_measurements" model="ir.actions.act_window"><field name="name">Measurements</field><field name="res_model">project.program.measurement</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_measurements" name="Measurements" parent="menu_program_root" action="action_measurements" sequence="30"/>
</odoo>
