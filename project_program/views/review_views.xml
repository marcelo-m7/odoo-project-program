<odoo>
    <record id="view_review_list" model="ir.ui.view"><field name="name">project.program.review.list</field><field name="model">project.program.review</field><field name="arch" type="xml"><list><field name="project_id"/><field name="period_start"/><field name="period_end"/><field name="state"/><field name="validated_at"/><field name="published_at"/></list></field></record>
    <record id="view_review_form" model="ir.ui.view"><field name="name">project.program.review.form</field><field name="model">project.program.review</field><field name="arch" type="xml"><form><header><button name="action_validate" type="object" string="Validate" invisible="state != 'draft'" class="oe_highlight"/><button name="action_publish" type="object" string="Publish" invisible="state != 'validated'" class="oe_highlight"/><field name="state" widget="statusbar" statusbar_visible="draft,validated,published"/></header><sheet><group><field name="project_id"/><field name="period_start"/><field name="period_end"/><field name="revision_of_id"/></group><group><field name="internal_notes"/><field name="public_summary"/><field name="validated_by"/><field name="validated_at"/><field name="published_by"/><field name="published_at"/></group><notebook><page string="Measurements"><field name="measurement_ids" readonly="state != 'draft'"><list><field name="goal_id"/><field name="measured_at"/><field name="value"/><field name="state"/></list></field></page></notebook></sheet></form></field></record>
    <record id="view_review_search" model="ir.ui.view"><field name="name">project.program.review.search</field><field name="model">project.program.review</field><field name="arch" type="xml"><search><field name="project_id"/><filter name="pending" string="Pending" domain="[('state','!=','published')]"/><group><filter name="project" string="Project" context="{'group_by':'project_id'}"/><filter name="state" string="State" context="{'group_by':'state'}"/></group></search></field></record>
    <record id="action_reviews" model="ir.actions.act_window"><field name="name">Reviews</field><field name="res_model">project.program.review</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_reviews" name="Reviews" parent="menu_program_root" action="action_reviews" sequence="40"/>
</odoo>
