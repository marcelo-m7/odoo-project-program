<odoo>
    <record id="view_project_program_inherit" model="ir.ui.view"><field name="name">project.project.program.form</field><field name="model">project.project</field><field name="inherit_id" ref="project.edit_project"/><field name="arch" type="xml"><xpath expr="//field[@name='partner_id']" position="after"><field name="program_id" groups="project_program.group_program_user" domain="[('company_id','=',company_id)]"/></xpath><xpath expr="//notebook" position="inside"><page string="Program Members" groups="project_program.group_program_user" invisible="not program_id"><field name="program_membership_ids"><list><field name="partner_id"/><field name="role"/><field name="is_lead"/><field name="valid_from"/><field name="valid_to"/><field name="active"/></list></field></page><page string="Program Reviews" groups="project_program.group_program_user" invisible="not program_id"><field name="program_review_ids"><list><field name="period_start"/><field name="period_end"/><field name="state"/></list></field></page></xpath></field></record>
    <record id="view_task_program_inherit" model="ir.ui.view"><field name="name">project.task.program.form</field><field name="model">project.task</field><field name="inherit_id" ref="project.view_task_form2"/><field name="arch" type="xml"><xpath expr="//field[@name='project_id']" position="after"><field name="program_activity_type" groups="project_program.group_program_user" invisible="not program_id"/><field name="calendar_event_id" groups="project_program.group_program_user" invisible="not program_id"/><field name="program_session_outcome" groups="project_program.group_program_user" invisible="not program_id"/><field name="program_id" invisible="1"/></xpath></field></record>
</odoo>
